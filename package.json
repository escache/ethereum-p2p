{
  "name": "nexeth",
  "version": "1.0.0-bridgenet-m1",
  "description": "Nexeth bridgenet — cross-chain testnet with CLI and operator portal",
  "main": "dist/bridgenet/orchestrator/start.js",
  "types": "dist/bridgenet/orchestrator/start.d.ts",
  "bin": {
    "nexeth": "dist/cli/bin/nexeth.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.bridgenet.json",
    "build:legacy": "tsc",
    "start": "node dist/bridgenet/orchestrator/start.js",
    "bridgenet": "TS_NODE_PROJECT=tsconfig.bridgenet.json ts-node bridgenet/orchestrator/start.ts",
    "demo:bridge": "TS_NODE_PROJECT=tsconfig.bridgenet.json ts-node bridgenet/orchestrator/demo.ts",
    "nexeth": "TS_NODE_PROJECT=tsconfig.bridgenet.json ts-node cli/bin/nexeth.ts",
    "dev": "TS_NODE_PROJECT=tsconfig.bridgenet.json ts-node bridgenet/orchestrator/start.ts",
    "test": "jest",
    "test:bridgenet": "jest bridgenet",
    "lint": "eslint bridgenet cli --ext .ts",
    "format": "prettier --write \"bridgenet/**/*.ts\" \"cli/**/*.ts\"",
    "clean": "rimraf dist",
    "check-types": "tsc -p tsconfig.bridgenet.json --noEmit",
    "validate": "npm run check-types && npm run test:bridgenet"
  },
  "keywords": [
    "ethereum",
    "p2p",
    "blockchain",
    "typescript",
    "network"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "crc": "^4.3.2",
    "events": "^3.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/crc": "^3.8.0",
    "@types/ws": "^8.5.13",
    "@types/jest": "^29.5.0",
    "@types/node": "^18.15.11",
    "@typescript-eslint/eslint-plugin": "^5.57.1",
    "@typescript-eslint/parser": "^5.57.1",
    "eslint": "^8.37.0",
    "jest": "^29.5.0",
    "prettier": "^2.8.7",
    "rimraf": "^4.4.1",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.3"
  }
} 